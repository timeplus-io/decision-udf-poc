# ---- engine: Timeplus Enterprise, amd64 build (the only build with Python UDFs). Proton OSS cannot run this PoC.
ENGINE_IMAGE=timeplus/timeplus-enterprise:3.4.1-rc.10
# default credentials of the Enterprise image; scripts/install.sh uses them for `timeplusd client`
TIMEPLUS_USER=proton
TIMEPLUS_PASSWORD=timeplus@t+

# ---- which backend the UDF calls: local | jev | mock   (read by the UDF from the engine's environment)
DECISION_BACKEND=local

# local: URL of the /v1/systemone server as seen from inside the engine container
#   ollama profile:  http://decision:11434
#   fake profile:    http://decision:11434
#   Ollama running natively on the host (Mac with Apple GPU): http://host.docker.internal:11434
DECISION_BASE_URL=http://decision:11434

# Pin the model. Ollama library decision models: tev1:0.8b (CPU), tev1 (4B), clef-flash (9B, GPU), pplx-decider (27B, big GPU)
# jev: jev-1.13.0.  fake: fake-systemone-v0.  Leave empty to accept whatever the server reports (not for benchmarks).
DECISION_MODEL=tev1:0.8b

# optional tuning (defaults in sql/02_udf.sql): rows per request (8 for Ollama, else 16), concurrency, timeouts
#DECISION_PACK_ROWS=
#DECISION_MAX_IN_FLIGHT=6
#DECISION_TIMEOUT_S=5
#DECISION_BLOCK_DEADLINE_S=20
#DECISION_RETRIES=1
#DECISION_CACHE_TTL_S=0
#DECISION_TEMPERATURES={}

# jev only
TYPESAFE_API_KEY=

# fake backend knobs
FAKE_LATENCY_MS=120
FAKE_FAIL_RATE=0

# llama profile image (built from backend/Dockerfile.local)
DECISION_LOCAL_IMAGE=timeplus/decision-local:decider-2b-q8_0

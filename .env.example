# ---- engine: Proton OSS (default) or Timeplus Enterprise
ENGINE_IMAGE=ghcr.io/timeplus-io/proton:latest
# ENGINE_IMAGE=timeplus/timeplus-enterprise:latest
TIMEPLUS_HTTP=http://localhost:8123

# ---- which backend the UDF calls: local | jev | mock
DECISION_BACKEND=local

# local: URL of the /v1/systemone server as seen from the engine container
#   ollama profile:  http://decision:11434     (Ollama natively on a Mac: http://host.docker.internal:11434)
#   fake profile:    http://decision:11434
DECISION_BASE_URL=http://decision:11434

# Pin the model. Ollama library decision models: tev1:0.8b (CPU), tev1 (4B), clef-flash (9B, GPU), pplx-decider (27B, big GPU)
# jev: jev-1.13.0.  fake: fake-systemone-v0.  Leave empty to accept whatever the server reports (not for benchmarks).
DECISION_MODEL=tev1:0.8b

# jev only
TYPESAFE_API_KEY=

# fake backend knobs
FAKE_LATENCY_MS=120
FAKE_FAIL_RATE=0

# llama profile image (built from backend/Dockerfile.local)
DECISION_LOCAL_IMAGE=timeplus/decision-local:decider-2b-q8_0
